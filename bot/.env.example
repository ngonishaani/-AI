# Required for full AI replies (directory fallback works without it)
GEMINI_API_KEY=
# Current models: gemini-3.8-flash | gemini-3.5-flash-lite | gemini-3.6-flash
GEMINI_MODEL=gemini-3.8-flash
GEMINI_RETRIES=3

# Baileys session folder (default: ./auth_info_baileys)
# On Render this is set to /var/data/auth_info_baileys (persistent disk)
BAILEYS_AUTH_DIR=

# HTTP port for /health and pairing page (Render sets PORT automatically)
PORT=10000

# Optional: auto-request pairing code for this number (digits + country code, no +)
# Example Zimbabwe: 26377xxxxxxx
WHATSAPP_PHONE_NUMBER=

# Optional
LOG_LEVEL=info
BOT_RECONNECT_MS=3000
BOT_ALLOW_GROUPS=0

# Optional cron broadcast (Africa/Harare). Example JID: 26377xxxxxxx@s.whatsapp.net
BOT_CRON_BROADCAST_JID=
BOT_CRON_BROADCAST_SCHEDULE=0 9 * * *
BOT_CRON_BROADCAST_TEXT=Good morning from Trade Square Mall · Kwekwe. Ask me about shops, dining, hours, or leasing space.

# Enrol page → bot catalog sync (PUT /catalog). Optional shared secret.
# If set, /enroll must send the same token (meta tsm-catalog-token).
CATALOG_SYNC_TOKEN=
# Optional override for enrolled-shops.json path (default: beside Baileys auth dir)
CATALOG_PATH=
