# Gemini (required for replies)
GEMINI_API_KEY=
# Optional override (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Meta WhatsApp Cloud API (required for WhatsApp webhook)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Same string you enter in Meta Developer → WhatsApp → Configuration → Verify token
WHATSAPP_VERIFY_TOKEN=
# Optional Graph API version
WHATSAPP_GRAPH_VERSION=v21.0

# Public number for the site “Chat on WhatsApp” button (digits only, country code, e.g. 26377…)
WHATSAPP_DISPLAY_NUMBER=
